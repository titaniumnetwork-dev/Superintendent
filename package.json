{
	"name": "superintendent",
	"module": "index.ts",
	"type": "module",
	"packageManager": "pnpm@11.2.2",
	"engines": {
		"node": "24"
	},
	"scripts": {
		"start": "tsx src/index.ts",
		"dev": "NODE_ENV=development tsx watch src/index.ts",
		"fmt": "bunx --bun biome format --write .",
		"lint": "bunx --bun biome lint .",
		"lint:fix": "bunx --bun biome lint --write .",
		"check": "bunx --bun biome check .",
		"check:fix": "bunx --bun biome check --write .",
		"typecheck": "bunx tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.13",
		"@types/node": "^25.0.10",
		"tslib": "^2.8.1",
		"tsx": "^4.19.2",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"seyfert": "^4.1.0"
	}
}
