{
	"name": "@titaniumnetwork-dev/superintendent",
	"module": "src/index.ts",
	"type": "module",
	"packageManager": "pnpm@11.2.2",
	"engines": {
	  "node": ">=24"
	},
	"scripts": {
		"start": "tsx src/index.ts",
		"dev": "NODE_ENV=development tsx --watch src/index.ts",
		"fmt": "biome format --write .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@types/node": "^26.2.0",
		"tslib": "^2.8.1",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"seyfert": "^5.0.0"
	}
}
