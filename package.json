{
	"name": "superintendent",
	"module": "index.ts",
	"type": "module",
	"scripts": {
		"start": "bun src/index.ts",
		"dev": "NODE_ENV=development bun --watch src/index.ts",
		"fmt": "bunx --bun biome format --write .",
		"lint": "bunx --bun biome lint .",
		"lint:fix": "bunx --bun biome lint --write .",
		"check": "bunx --bun biome check .",
		"check:fix": "bunx --bun biome check --write .",
		"typecheck": "bunx tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.6",
		"@types/bun": "^1.3.0",
		"@types/node": "^25.0.10",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"seyfert": "^4.1.0"
	}
}
